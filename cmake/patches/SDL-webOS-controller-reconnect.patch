         if (!SDL_HIDAPI_discovery.m_unLastDetect || SDL_TICKS_PASSED(now, next_detect)) {
             // Loop through /dev/hidraw*
             Uint32 flags = SDL_webOSGetDevicePresenceFlags(SDL_WEBOS_DEVICE_PRESENCE_CHECK_HIDRAW);
